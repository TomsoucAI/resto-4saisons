---
import infos from '../data/infos.json';
const { compact = false } = Astro.props;
const url = infos.googleReviewUrl;
const aria = 'Laisser un avis sur Google (ouvre Google dans un nouvel onglet)';

// Google "G" mark (nominative use for a "review on Google" link)
const googleG = `<svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.76h3.56c2.08-1.92 3.28-4.74 3.28-8.09Z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.56-2.76c-.98.66-2.23 1.06-3.72 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.06l3.66 2.84C6.71 7.3 9.14 5.38 12 5.38Z"/></svg>`;
---
{compact ? (
  <a href={url} target="_blank" rel="noopener noreferrer" aria-label={aria}
     class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-charcoal transition hover:bg-white/90">
    <Fragment set:html={googleG} />
    Laissez-nous un avis Google
  </a>
) : (
  <div class="mx-auto mt-10 max-w-md rounded-xl bg-charcoal-soft p-6 text-center">
    <div class="text-lg tracking-widest text-amber-400" aria-hidden="true">★★★★★</div>
    <p class="mt-2 font-display text-lg font-bold text-white">Vous avez aimé votre visite ?</p>
    <p class="mt-1 text-sm text-white/60">Partagez votre expérience sur Google — ça nous aide énormément.</p>
    <a href={url} target="_blank" rel="noopener noreferrer" aria-label={aria}
       class="mt-4 inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 font-semibold text-charcoal transition hover:bg-white/90">
      <Fragment set:html={googleG} />
      Laisser un avis
    </a>
  </div>
)}
