---
import Carousel from './Carousel.astro';

// Any image dropped in src/assets/gallery/ becomes a slide (sorted by filename).
const slides = import.meta.glob('../assets/gallery/*.{jpg,jpeg,png,webp}', { eager: true });
const images = Object.entries(slides)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---
{images.length > 0 && (
  <section id="galerie" class="scroll-mt-20 bg-charcoal py-14 text-white">
    <div class="mx-auto max-w-3xl px-4">
      <p class="text-xs font-semibold tracking-[0.2em] text-brick">EN IMAGES</p>
      <h2 class="mt-2 font-display text-3xl font-bold">Le restaurant &amp; nos plats</h2>
      <div class="mt-6 shadow-lg">
        <Carousel images={images} label="Restaurant 4 Saisons" />
      </div>
    </div>
  </section>
)}
