---
import PriceTable from './PriceTable.astro';
const { category } = Astro.props;
const count = category.items.length;
---
<details class="menu-cat group overflow-hidden rounded-xl bg-white shadow-sm transition hover:shadow-md">
  <summary class="flex cursor-pointer select-none items-center justify-between gap-3 px-4 py-4 sm:px-5">
    <span class="font-display text-lg font-bold text-charcoal">
      {category.nom}
      {count > 0 && <span class="ml-1.5 text-sm font-normal text-charcoal/40">({count})</span>}
    </span>
    <svg class="chevron h-5 w-5 shrink-0 text-brick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>

  <div class="border-t border-cream-line px-4 pb-4 pt-3 sm:px-5">
    {category.note && <p class="mb-3 text-sm italic text-charcoal/50">{category.note}</p>}
    {category.columns ? (
      <PriceTable category={category} />
    ) : category.items.length === 0 ? null : (
      <ul class="divide-y divide-cream-line">
        {category.items.map((item) => (
          <li class="flex items-baseline justify-between gap-4 py-2.5">
            <span class="font-semibold">
              {item.nom}
              {item.desc && <span class="block text-xs font-normal text-charcoal/50">{item.desc}</span>}
            </span>
            <span class="tabular-nums font-semibold whitespace-nowrap">{item.price} $</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</details>
